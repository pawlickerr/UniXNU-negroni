diff --git a/bsd/dev/negroni_ufs.c b/bsd/dev/negroni_ufs.c
index 2d53500..8aff029 100644
--- a/bsd/dev/negroni_ufs.c
+++ b/bsd/dev/negroni_ufs.c
@@ -687,14 +687,18 @@ negroni_ufs_init(void)
 	error = ufs_take_over_host();
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
-		static const uint8_t start[6] = { 0x1b, 0, 0, 0, 0x01, 0 };	/* START STOP UNIT: start */
+		/* UFS START STOP UNIT: POWER CONDITION = active (1), sent to the UFS Device W-LUN (0xd0). */
+		static const uint8_t start[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
 		/*
 		 * The first commands after the bootloader report unit attentions;
 		 * a stopped (not ready) device needs START STOP UNIT.
 		 */
 		for (int i = 0; i < 20 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
 			if (ufs_last_sense == 0x2) {
-				(void)ufs_scsi(start, sizeof(start), 0, false);
+				su.lun = 0xd0;
+				int rc = ufs_scsi(start, sizeof(start), 0, false);
+				su.lun = 0;
+				printf("NEGRONI UFS: device power mode active: %d\n", rc);
 			}
 			delay(10000);
 		}
