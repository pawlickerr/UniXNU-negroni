 }
+
+/* Read-only cmd-db lookup of a VRM resource address (Wi-Fi survey, negroni_wifi.c). */
+int negroni_rpmh_lookup(const char *res, uint32_t *address);
+
+int
+negroni_rpmh_lookup(const char *res, uint32_t *address)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, address);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
