diff --git a/bsd/dev/negroni_adreno.c b/bsd/dev/negroni_adreno.c
index 2115af8..cb9100b 100644
--- a/bsd/dev/negroni_adreno.c
+++ b/bsd/dev/negroni_adreno.c
@@ -1415,6 +1415,13 @@ step_hfi_messages(void)
 	    !hfi_send("START", HFI_MSG_START, one, sizeof(one))) {
 		return false;
 	}
+	/* a6xx_gmu_resume after a6xx_hfi_start: interrupts, then the initial GX perf/bw vote (HFI 30) */
+	gmu_put("GMU2HOST_INTR_CLR", GMU_GMU2HOST_INTR_CLR, ~0u);
+	gmu_put("GMU2HOST_INTR_MASK", 0x1f993, ~1u);
+	uint32_t vote[4] = { 0, 1 /* blocking ack */, 1 /* 220 MHz */, 3 /* bw level 3 */ };
+	if (!hfi_send("GX_BW_PERF_VOTE", 30, vote, sizeof(vote))) {
+		return false;
+	}
 	printf("NEGRONI ADRENO: 17 GMU TAKES ITS TABLES AND IS STARTED\n");
 	return !space_faulted(&gmu_space);
 }
