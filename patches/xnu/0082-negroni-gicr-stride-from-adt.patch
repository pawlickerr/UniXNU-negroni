diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..93a2f49 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -20,6 +20,8 @@ MACHINE_TIMEOUT(gicr_wake_timeout_ns, "gicr-wake-timeout", GICR_WAKE_TIMEOUT_NS,
 #if defined(NEGRONI)
 /* Phone default; QEMU virt wires the architected virtual timer to INTID 27. */
 SECURITY_READ_ONLY_LATE(uint32_t) negroni_vtimer_intid = NEGRONI_VTIMER_INTID;
+/* negroni (GICv3): 2 frames per PE; SM8450 negroni (GICv4, VLPI frames): 4. */
+SECURITY_READ_ONLY_LATE(uint32_t) negroni_gicr_stride = GICR_PE_SIZE;
 #endif
 
 static vm_offset_t gicd_base;
@@ -56,7 +58,11 @@ find_gicr_pe_base()
 	// We only care about aff1 and aff0
 	uint32_t phys_id = __builtin_arm_rsr64("MPIDR_EL1") & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK);
 
+#if defined(NEGRONI)
+	for (vm_offset_t offset = 0; offset < gicr_size; offset += negroni_gicr_stride) {
+#else
 	for (vm_offset_t offset = 0; offset < gicr_size; offset += GICR_PE_SIZE) {
+#endif
 		vm_offset_t gicr_pe_base = gicr_base + offset;
 		uint64_t gicr_typer = gicr_read64(GICR_TYPER);
 		uint32_t aff_value = (uint32_t) (gicr_typer >> GICR_TYPER_AFFINITY_VALUE_SHIFT) & (MPIDR_AFF1_MASK | MPIDR_AFF0_MASK);
@@ -117,6 +123,21 @@ pe_init_fiq()
 			negroni_vtimer_intid = intid;
 		}
 		kprintf("NEGRONI GIC: virtual timer INTID %u\n", negroni_vtimer_intid);
+
+		/* Same name and meaning as the Linux GICv3 binding's redistributor-stride. */
+		void const *stride_prop;
+		unsigned int stride_size;
+		if (SecureDTGetProperty(entry, "redistributor-stride", &stride_prop, &stride_size) == kSuccess) {
+			if (stride_size != sizeof(uint32_t)) {
+				panic("%s: invalid redistributor-stride size %u", __func__, stride_size);
+			}
+			uint32_t stride = *(const uint32_t *)stride_prop;
+			if (stride != 0x20000 && stride != 0x40000) {
+				panic("%s: unsupported redistributor stride 0x%x", __func__, stride);
+			}
+			negroni_gicr_stride = stride;
+		}
+		kprintf("NEGRONI GIC: redistributor stride 0x%x\n", negroni_gicr_stride);
 #endif
 
 		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
