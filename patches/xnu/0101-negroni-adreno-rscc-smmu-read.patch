@@ -75,6 +78,33 @@ void negroni_adreno_init(void);
 #define GMU_AO_COUNTER_L        0x1f888
 #define GMU_CM3_SYSRESET        0x1f800
 #define GMU_CM3_FW_INIT_RESULT  0x1f81c
+#define GMU_RSCC_CONTROL_ACK    0x23b08
+
+/* RSCC (a6xx_gmu.xml domain A6XX_RSCC, dword offsets; A730 keeps the pre-A740 layout) */
+#define RSCC_PHYS               0x03d50000UL
+#define RSCC_SIZE               0x10000UL
+#define RSCC_RSC_STATUS0_DRV0   (4 * 0x004)
+#define RSCC_PDC_SLAVE_ID_DRV0  (4 * 0x00b)
+#define RSCC_SEQ_BUSY_DRV0      (4 * 0x101)
+#define RSCC_SEQ_MEM_0_DRV0     (4 * 0x180)
+#define RSCC_TCS0_DRV0_STATUS   (4 * 0x346)
+
+/* adreno SMMU (arm-smmu.h); streams: GPU 0 and 1, GMU 5 (mask 0x400) */
+#define SMMU_PHYS               0x03da0000UL
+#define SMMU_SIZE               0x40000UL
+#define SMMU_SCR0               0x000
+#define SMMU_IDR0               0x020           /* [7:0] stream match registers */
+#define SMMU_IDR1               0x024           /* [31] 64K pages, [30:28] log2(pages)-1, [7:0] contexts */
+#define SMMU_IDR2               0x028
+#define SMMU_IDR7               0x03c
+#define SMMU_SGFSR              0x048
+#define SMMU_SMR(n)             (0x800 + 4 * (n))
+#define SMMU_S2CR(n)            (0xc00 + 4 * (n))
+#define SMMU_CBAR(n)            (4 * (n))       /* in the second page */
+#define SMMU_CB_SCTLR           0x00
+#define SMMU_CB_TTBR0           0x20
+#define SMMU_CB_TCR             0x30
