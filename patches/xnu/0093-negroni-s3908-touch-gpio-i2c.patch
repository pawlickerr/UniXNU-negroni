 /*
- * NEGRONI SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
- * Call once after the scheduler is running; all work runs on one thread.
- * Requires ABL-loaded GENI I2C firmware; votes L11C through negroni_rpmh.c.
- * No firmware/config upload or direct PMIC writes. Only IC data write:
- * zero to GT9896's event status after reading a report. See touch2/report.md.
+ * NEGRONI Synaptics S3908 (TouchComm, I2C 0x4b) touch.
+ * QUP0 SE4 has its FIFO disabled (GPI only, DMA block secure-locked), so the
+ * bus is open-drain GPIO16/17 I2C, the same code as Mu's NegroniTouchDxe
+ * (bsd/dev/negroni_touch/ = ios-sweet drivers/negroni-touch). Mu powers the
+ * panel (L6C, L3C, 1.8 V switch) and leaves it on; this thread polls ATTN
+ * (GPIO21, active low) every 10 ms and reports fingers to NegroniHIDTouch.
+ * Call once after the scheduler is running.
  */
 #if defined(ARM64_BOARD_CONFIG_NEGRONI)
 #include <sys/param.h>
@@ -15,621 +17,187 @@
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 
+#include "negroni_touch/tlmm_i2c.h"
+#include "negroni_touch/syna_tcm.h"
+
