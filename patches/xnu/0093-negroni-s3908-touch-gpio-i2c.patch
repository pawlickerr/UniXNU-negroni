diff --git a/bsd/dev/negroni_touch/gpio_i2c.h b/bsd/dev/negroni_touch/gpio_i2c.h
new file mode 100755
index 0000000..5fc2528
--- /dev/null
+++ b/bsd/dev/negroni_touch/gpio_i2c.h
@@ -0,0 +1,100 @@
+/* Polled open-drain I2C fallback; 5 us half-period, bounded clock stretching.
+ * Line callbacks release the pin for 1 and drive only LOW for 0.
+ * Caller owns the bus and serializes transfers. No GENI/GPI accesses.
+ */
+#ifndef NEGRONI_GPIO_I2C_H
+#define NEGRONI_GPIO_I2C_H
+#include <stdint.h>
+struct gpio_i2c {
+    void *ctx;
+    void (*sda)(void *, int);
+    void (*scl)(void *, int);
+    int (*get_sda)(void *);
+    int (*get_scl)(void *);
+    void (*delay)(unsigned);
+};
+/* Same transport codes as geni_i2c: -2 NACK, -3 bus busy, -4 timeout. */
+static inline int gi_high(struct gpio_i2c *g)
+{
+    g->scl(g->ctx, 1);
+    for (unsigned n = 0; n < 1000; n++) {
+        if (g->get_scl(g->ctx)) { g->delay(5); return 0; }
+        g->delay(1);
+    }
+    return -4;
+}
+static inline void gi_low(struct gpio_i2c *g)
+{
+    g->scl(g->ctx, 0);
+    g->delay(5);
+}
+static inline int gi_stop(struct gpio_i2c *g)
+{
+    gi_low(g);
+    g->sda(g->ctx, 0);
+    g->delay(5);
+    int rc = gi_high(g);
+    g->sda(g->ctx, 1);
+    g->delay(5);
+    return rc;
+}
+static inline int gi_byte(struct gpio_i2c *g, uint8_t v)
+{
+    for (unsigned i = 0; i < 8; i++) {
+        g->sda(g->ctx, (v & 0x80) != 0);
+        g->delay(5);
+        int rc = gi_high(g);
+        if (rc) return rc;
+        gi_low(g);
+        v <<= 1;
+    }
+    g->sda(g->ctx, 1);
+    g->delay(5);
+    int rc = gi_high(g);
+    if (rc) return rc;
+    int nack = g->get_sda(g->ctx);
+    gi_low(g);
+    return nack ? -2 : 0;
+}
+static inline int gi_start(struct gpio_i2c *g, uint8_t addr, int read)
+{
+    g->sda(g->ctx, 1);
+    int rc = gi_high(g);
+    if (rc) return rc;
+    if (!g->get_sda(g->ctx)) return -3;
+    g->sda(g->ctx, 0);
+    g->delay(5);
+    gi_low(g);
+    return gi_byte(g, (uint8_t)((addr << 1) | read));
+}
+static inline int gpio_i2c_write(struct gpio_i2c *g, uint8_t addr, const uint8_t *buf, uint32_t len)
+{
+    int rc = gi_start(g, addr, 0);
+    for (uint32_t i = 0; !rc && i < len; i++) rc = gi_byte(g, buf[i]);
+    int stop = gi_stop(g);
+    return rc ? rc : stop;
+}
+static inline int gpio_i2c_read(struct gpio_i2c *g, uint8_t addr, uint8_t *buf, uint32_t len)
+{
+    int rc = gi_start(g, addr, 1);
+    for (uint32_t i = 0; !rc && i < len; i++) {
+        uint8_t v = 0;
+        g->sda(g->ctx, 1);
+        for (unsigned bit = 0; bit < 8; bit++) {
+            rc = gi_high(g);
+            if (rc) break;
+            v = (uint8_t)((v << 1) | !!g->get_sda(g->ctx));
+            gi_low(g);
+        }
+        if (rc) break;
+        buf[i] = v;
+        g->sda(g->ctx, i + 1 == len); /* ACK each byte except the last. */
+        g->delay(5);
+        rc = gi_high(g);
+        gi_low(g);
+        g->sda(g->ctx, 1);
+    }
+    int stop = gi_stop(g);
+    return rc ? rc : stop;
+}
+#endif
diff --git a/bsd/dev/negroni_touch/syna_tcm.h b/bsd/dev/negroni_touch/syna_tcm.h
new file mode 100755
index 0000000..27ca6a3
--- /dev/null
+++ b/bsd/dev/negroni_touch/syna_tcm.h
@@ -0,0 +1,262 @@
+/*
+ * Synaptics TouchComm (TCM v1) host side for the negroni S3908, OS independent.
+ *
+ * From the OPLUS driver in the XEC negroni tree (476a4a8,
+ * drivers/input/touchscreen/synaptics_tcm_oncell.{c,h}):
+ *   read:  4-byte header {0xA5, code, len_lo, len_hi}; when len > 0 a second
+ *          read of len + 3 bytes {0xA5, 0x03 (continued read), payload, 0x5A}
+ *   write: {command, len_lo, len_hi, payload...}
+ *   touch report 0x11 is a bit stream described by the touch report config
+ *   (command 0x25), parsed like syna_parse_report().
+ *
+ * The transport is the caller's: tcm_io.read/write move whole I2C messages.
+ */
+#ifndef NEGRONI_SYNA_TCM_H
+#define NEGRONI_SYNA_TCM_H
+
+#include <stdint.h>
+
+#define TCM_MARKER			0xA5
+#define TCM_PADDING			0x5A
+#define TCM_STATUS_IDLE			0x00
+#define TCM_STATUS_OK			0x01
+#define TCM_STATUS_BUSY			0x02
+#define TCM_STATUS_CONTINUED_READ	0x03
+#define TCM_REPORT_IDENTIFY		0x10
+#define TCM_REPORT_TOUCH		0x11
+#define TCM_CMD_GET_TOUCH_REPORT_CONFIG	0x25
+
+#define TCM_MAX_OBJECTS			10
+#define TCM_MAX_PAYLOAD			512
+#define TCM_MAX_CONFIG			256
+
+/* touch report config codes (enum touch_report_code) */
+enum {
+	TCM_TOUCH_END = 0,
+	TCM_TOUCH_FOREACH_ACTIVE_OBJECT,
+	TCM_TOUCH_FOREACH_OBJECT,
+	TCM_TOUCH_FOREACH_END,
+	TCM_TOUCH_PAD_TO_NEXT_BYTE,
+	TCM_TOUCH_TIMESTAMP,
+	TCM_TOUCH_OBJECT_N_INDEX,
+	TCM_TOUCH_OBJECT_N_CLASSIFICATION,
+	TCM_TOUCH_OBJECT_N_X_POSITION,
+	TCM_TOUCH_OBJECT_N_Y_POSITION,
+	TCM_TOUCH_OBJECT_N_Z,
+	TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS = 24,
+};
+
+/* negroni DT: touchpanel,panel-coords = <5760 12864>, display-coords = <1440 3216> */
+#define TCM_PANEL_MAX_X			5760
+#define TCM_PANEL_MAX_Y			12864
+
+struct tcm_io {
+	void *ctx;
+	int (*read)(void *ctx, uint8_t *buf, uint32_t len);		/* 0 = ok */
+	int (*write)(void *ctx, const uint8_t *buf, uint32_t len);
+};
+
+struct tcm_object {
+	uint8_t status;		/* classification: 0 none, 1 finger, others glove/palm/hover */
+	uint32_t x, y, z;
+};
+
+struct tcm {
+	struct tcm_io io;
+	uint8_t config[TCM_MAX_CONFIG];
+	uint32_t config_len;
+	uint8_t payload[TCM_MAX_PAYLOAD];
+	uint32_t payload_len;
+	uint8_t code;
+	uint8_t header[4];	/* last wire header, for diagnostics */
+	int transport_error;	/* preserve the bus driver's failure code */
+	struct tcm_object obj[TCM_MAX_OBJECTS];
+};
+
+/*
+ * Read one message. 0: message in t->code / t->payload; 1: nothing pending
+ * (no marker, the controller has no data); <0: transport or framing error.
+ */
+static inline int tcm_read_message(struct tcm *t)
+{
+	uint8_t *hdr = t->header;
+	uint8_t buf[TCM_MAX_PAYLOAD + 3];
+	uint32_t len;
+
+	t->code = 0;
+	t->payload_len = 0;
+	for (uint32_t i = 0; i < 4; i++)
+		hdr[i] = 0;
+	t->transport_error = t->io.read(t->io.ctx, hdr, 4);
+	if (t->transport_error)
+		return -1;
+	if (hdr[0] != TCM_MARKER)
+		return 1;
+	t->code = hdr[1];
+	/* Idle/busy have no payload, even if their length bytes contain filler. */
+	if (t->code == TCM_STATUS_IDLE || t->code == TCM_STATUS_BUSY)
+		return 1;
+	if (t->code == TCM_STATUS_CONTINUED_READ)
+		return -3;	/* a previous reader consumed the message header */
+	len = hdr[2] | ((uint32_t)hdr[3] << 8);
+	t->payload_len = 0;
+	if (!len)
+		return 0;
+	if (len > TCM_MAX_PAYLOAD)
+		return -2;
+	t->transport_error = t->io.read(t->io.ctx, buf, len + 3);
+	if (t->transport_error)
+		return -1;
+	if (buf[0] != TCM_MARKER || buf[1] != TCM_STATUS_CONTINUED_READ || buf[len + 2] != TCM_PADDING)
+		return -3;
+	for (uint32_t i = 0; i < len; i++)
+		t->payload[i] = buf[2 + i];
+	t->payload_len = len;
+	return 0;
+}
+
+static inline int tcm_write_command(struct tcm *t, uint8_t cmd, const uint8_t *payload, uint32_t len)
+{
+	uint8_t buf[3 + 32];
+
+	if (len > 32)
+		return -2;
+	buf[0] = cmd;
+	buf[1] = (uint8_t)len;
+	buf[2] = (uint8_t)(len >> 8);
+	for (uint32_t i = 0; i < len; i++)
+		buf[3 + i] = payload[i];
+	t->transport_error = t->io.write(t->io.ctx, buf, 3 + len);
+	return t->transport_error ? -1 : 0;
+}
+
+/*
+ * Send a command and wait for its response; reports that arrive in between are
+ * dropped. wait() is the caller's delay (about 1 ms) between polls.
+ */
+static inline int tcm_command(struct tcm *t, uint8_t cmd, const uint8_t *payload, uint32_t len,
+			      void (*wait)(void), uint32_t tries)
+{
+	if (tcm_write_command(t, cmd, payload, len))
+		return -1;
+	while (tries--) {
+		int rc = tcm_read_message(t);
+
+		if (rc < 0)
+			return rc;
+		if (rc == 0 && t->code < TCM_REPORT_IDENTIFY)
+			return t->code == TCM_STATUS_OK ? 0 : -4;
+		wait();
+	}
+	return -5;
+}
+
+/* Fetch the touch report config (needed by tcm_parse_touch). */
+static inline int tcm_get_report_config(struct tcm *t, void (*wait)(void))
+{
+	int rc = tcm_command(t, TCM_CMD_GET_TOUCH_REPORT_CONFIG, 0, 0, wait, 200);
+
+	if (rc)
+		return rc;
+	if (t->payload_len > TCM_MAX_CONFIG)
+		return -2;
+	for (uint32_t i = 0; i < t->payload_len; i++)
+		t->config[i] = t->payload[i];
+	t->config_len = t->payload_len;
+	return 0;
+}
+
+/* syna_get_report_data(): bits (<= 32) at bit offset, LSB first. */
+static inline uint32_t tcm_bits(const struct tcm *t, uint32_t offset, uint32_t bits)
+{
+	uint32_t out = 0, done = 0;
+
+	if (!bits || bits > 32 || offset + bits > t->payload_len * 8)
+		return 0;
+	while (done < bits) {
+		uint32_t byte = offset / 8, shift = offset % 8;
+		uint32_t take = 8 - shift < bits - done ? 8 - shift : bits - done;
+		uint32_t v = ((uint32_t)t->payload[byte] >> shift) & (0xffu >> (8 - take));
+
+		out |= v << done;
+		done += take;
+		offset += take;
+	}
+	return out;
+}
+
+/* Parse a touch report (t->code == TCM_REPORT_TOUCH) into t->obj[]. 0 or <0. */
+static inline int tcm_parse_touch(struct tcm *t)
+{
+	uint32_t idx = 0, offset = 0, obj = 0, next = 0, objects = 0, active = 0;
+	int active_only = 0, have_active = 0;
+
+	for (int i = 0; i < TCM_MAX_OBJECTS; i++)
+		t->obj[i].status = 0;
+	while (idx < t->config_len) {
+		uint8_t code = t->config[idx++];
+		uint32_t bits, v;
+
+		switch (code) {
+		case TCM_TOUCH_END:
+			return 0;
+		case TCM_TOUCH_FOREACH_ACTIVE_OBJECT:
+		case TCM_TOUCH_FOREACH_OBJECT:
+			obj = 0;
+			next = idx;
+			active_only = code == TCM_TOUCH_FOREACH_ACTIVE_OBJECT;
+			break;
+		case TCM_TOUCH_FOREACH_END:
+			if (active_only) {
+				if (have_active) {
+					if (++objects < active)
+						idx = next;
+				} else if (offset < t->payload_len * 8) {
+					idx = next;
+				}
+			} else if (++obj < TCM_MAX_OBJECTS) {
+				idx = next;
+			}
+			break;
+		case TCM_TOUCH_PAD_TO_NEXT_BYTE:
+			offset = (offset + 7) & ~7u;
+			break;
+		default:
+			if (idx >= t->config_len)
+				return -1;
+			bits = t->config[idx++];
+			v = tcm_bits(t, offset, bits);
+			offset += bits;
+			switch (code) {
+			case TCM_TOUCH_OBJECT_N_INDEX:
+				if (v >= TCM_MAX_OBJECTS)
+					return -1;
+				obj = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_CLASSIFICATION:
+				t->obj[obj].status = (uint8_t)v;
+				break;
+			case TCM_TOUCH_OBJECT_N_X_POSITION:
+				t->obj[obj].x = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_Y_POSITION:
+				t->obj[obj].y = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_Z:
+				t->obj[obj].z = v;
+				break;
+			case TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS:
+				active = v;
+				have_active = 1;
+				if (!active)
+					return 0;
+				break;
+			default:	/* timestamp, widths, gestures, grip: skipped */
+				break;
+			}
+		}
+	}
+	return 0;
+}
+
+#endif
diff --git a/bsd/dev/negroni_touch/tlmm.h b/bsd/dev/negroni_touch/tlmm.h
new file mode 100755
index 0000000..84ee57a
--- /dev/null
+++ b/bsd/dev/negroni_touch/tlmm.h
@@ -0,0 +1,93 @@
+/*
+ * SM8450 TLMM pin control, MMIO only (Linux drivers/pinctrl/qcom/pinctrl-msm.c
+ * layout, pinctrl-sm8450.c: REG_SIZE 0x1000, ctl at n * 0x1000, io at +4).
+ * TLMM base 0x0F100000 (sm8450.dtsi tlmm: pinctrl@f100000).
+ */
+#ifndef NEGRONI_TLMM_H
+#define NEGRONI_TLMM_H
+
+#include <stdint.h>
+
+#define TLMM_BASE		0x0F100000u
+#define TLMM_CTL(n)		((uint32_t)(n) * 0x1000u)
+#define TLMM_IO(n)		((uint32_t)(n) * 0x1000u + 4u)
+
+#define TLMM_PULL_NONE		0u
+#define TLMM_PULL_DOWN		1u
+#define TLMM_PULL_UP		3u
+#define TLMM_FUNC(f)		((uint32_t)(f) << 2)		/* 0 = gpio */
+#define TLMM_DRIVE_MA(ma)	((uint32_t)((ma) / 2 - 1) << 6)
+#define TLMM_OE			(1u << 9)
+#define TLMM_IN			(1u << 0)
+#define TLMM_OUT		(1u << 1)
+
+/* negroni touch pins (sm8450.dtsi qup_i2c4_data_clk, negroni.dts ts_*_active, synaptics20031@4b) */
+#define NT_PIN_I2C_SDA		16	/* function qup4 = 1 */
+#define NT_PIN_I2C_SCL		17
+#define NT_PIN_RESET		20	/* active low */
+#define NT_PIN_IRQ		21	/* ATTN, active low */
+#define NT_PIN_1V8_EN		186	/* enable1v8_gpio: driven high to enable (oplus touchpanel uses the raw gpio number, the DT flag is not applied) */
+#define NT_FUNC_QUP4		1
+
+static inline void tlmm_cfg(volatile uint8_t *tlmm, unsigned pin, uint32_t cfg)
+{
+	*(volatile uint32_t *)(tlmm + TLMM_CTL(pin)) = cfg;
+}
+
+static inline void tlmm_out(volatile uint8_t *tlmm, unsigned pin, int high)
+{
+	*(volatile uint32_t *)(tlmm + TLMM_IO(pin)) = high ? TLMM_OUT : 0;
+}
+
+static inline int tlmm_in(volatile uint8_t *tlmm, unsigned pin)
+{
+	return (int)(*(volatile uint32_t *)(tlmm + TLMM_IO(pin)) & TLMM_IN);
+}
+
+/* I2C pins to qup4 with pull-ups, ATTN input, reset and 1.8 V enable as outputs (reset held). */
+/* SDA/SCL on qup4 with pull-ups */
+static inline void nt_pins_setup_i2c(volatile uint8_t *tlmm)
+{
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, TLMM_FUNC(NT_FUNC_QUP4) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SCL, TLMM_FUNC(NT_FUNC_QUP4) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP);
+}
+
+static inline void nt_pins_setup(volatile uint8_t *tlmm)
+{
+	nt_pins_setup_i2c(tlmm);
+	tlmm_cfg(tlmm, NT_PIN_IRQ, TLMM_FUNC(0) | TLMM_DRIVE_MA(8) | TLMM_PULL_NONE);
+	tlmm_out(tlmm, NT_PIN_RESET, 0);
+	tlmm_cfg(tlmm, NT_PIN_RESET, TLMM_FUNC(0) | TLMM_DRIVE_MA(8) | TLMM_PULL_NONE | TLMM_OE);
+	tlmm_out(tlmm, NT_PIN_1V8_EN, 1);	/* 1.8 V load switch on */
+	tlmm_cfg(tlmm, NT_PIN_1V8_EN, TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_NONE | TLMM_OE);
+}
+
+/*
+ * I2C bus recovery (i2c_generic_scl_recovery): SDA held low by a target that was cut off mid-byte.
+ * Pins as GPIO, open drain emulated with OE: up to 9 SCL pulses until SDA is released, then STOP.
+ * Returns the SDA level afterwards (1 = bus free). The caller puts the pins back on qup4.
+ */
+static inline int nt_i2c_recover(volatile uint8_t *tlmm, void (*udelay)(unsigned))
+{
+	uint32_t in = TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP;
+
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in);
+	udelay(10);
+	for (int i = 0; i < 9 && !tlmm_in(tlmm, NT_PIN_I2C_SDA); i++) {
+		tlmm_out(tlmm, NT_PIN_I2C_SCL, 0);
+		tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in | TLMM_OE);		/* drive SCL low */
+		udelay(5);
+		tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in);			/* release: pulled high */
+		udelay(5);
+	}
+	/* STOP: SDA low -> high while SCL is high */
+	tlmm_out(tlmm, NT_PIN_I2C_SDA, 0);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in | TLMM_OE);
+	udelay(5);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in);
+	udelay(5);
+	return tlmm_in(tlmm, NT_PIN_I2C_SDA);
+}
+
+#endif
diff --git a/bsd/dev/negroni_touch/tlmm_i2c.h b/bsd/dev/negroni_touch/tlmm_i2c.h
new file mode 100755
index 0000000..6252742
--- /dev/null
+++ b/bsd/dev/negroni_touch/tlmm_i2c.h
@@ -0,0 +1,26 @@
+/* Map only GPIO16/17 pages (0xf110000, length 0x2000). */
+#ifndef NEGRONI_TLMM_I2C_H
+#define NEGRONI_TLMM_I2C_H
+#include "gpio_i2c.h"
+#include "tlmm.h"
+struct tlmm_i2c { volatile uint8_t *pins; };
+static inline void ti_line(void *ctx, unsigned off, int release)
+{
+    struct tlmm_i2c *p = ctx;
+    /* Never drive a high level: latch zero, switch output enable only. */
+    *(volatile uint32_t *)(p->pins + off + 4) = 0;
+    *(volatile uint32_t *)(p->pins + off) = TLMM_FUNC(0) | TLMM_DRIVE_MA(2) |
+        TLMM_PULL_UP | (release ? 0 : TLMM_OE);
+    (void)*(volatile uint32_t *)(p->pins + off); /* complete configuration write */
+}
+static inline void ti_sda(void *p, int r) { ti_line(p, 0, r); }
+static inline void ti_scl(void *p, int r) { ti_line(p, 0x1000, r); }
+static inline int ti_get_sda(void *p) { return *(volatile uint32_t *)(((struct tlmm_i2c *)p)->pins + 4) & 1; }
+static inline int ti_get_scl(void *p) { return *(volatile uint32_t *)(((struct tlmm_i2c *)p)->pins + 0x1004) & 1; }
+static inline void tlmm_i2c_init(struct gpio_i2c *g, struct tlmm_i2c *pins, void (*delay)(unsigned))
+{
+    g->ctx = pins; g->sda = ti_sda; g->scl = ti_scl;
+    g->get_sda = ti_get_sda; g->get_scl = ti_get_scl; g->delay = delay;
+    ti_sda(pins, 1); ti_scl(pins, 1); delay(5);
+}
+#endif
