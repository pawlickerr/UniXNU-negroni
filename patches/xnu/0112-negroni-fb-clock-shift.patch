@@ -444,6 +477,9 @@ AppleCLCD::present(const uint8_t *rec)
 			src = 0;
 		}
 		if (src != 0 && bpe == 4) {
+			if (dy == 0 && dx == 0 && h >= 150 && w >= (int32_t)fWidth / 2) {
+				topRedrawn = true;      /* this frame rewrote the status bar's left ear */
+			}
 			for (int32_t y = 0; y < h; y++) {
 				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
 				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
@@ -452,6 +488,9 @@ AppleCLCD::present(const uint8_t *rec)
 		}
 		s->release();
 	}
+	if (topRedrawn) {
