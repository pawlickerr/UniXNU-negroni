+/*
+ * negronifb_clockshift=N: move the left ear of the status bar (rows 0..N_ROWS, the
+ * left half: only the clock is there) N pixels to the right, so the clock clears the
+ * punch-hole camera; the rest of the picture is untouched. Done after each copy.
+ */
+static int negroni_clock_shift = -1;
+
+static void
+negroni_shift_clock(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	const uint32_t rows = 150;
+
+	if (negroni_clock_shift < 0) {
+		negroni_clock_shift = 0;
+		PE_parse_boot_argn("negronifb_clockshift", &negroni_clock_shift, sizeof(negroni_clock_shift));
+		if (negroni_clock_shift < 0 || negroni_clock_shift > 400) {
+			negroni_clock_shift = 0;
+		}
+	}
+	uint32_t n = (uint32_t)negroni_clock_shift, half = width / 2;
+	if (n == 0 || n >= half || rows > height) {
+		return;
+	}
+	for (uint32_t y = 0; y < rows; y++) {
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		memmove(row + n, row, (size_t)(half - n) * 4);
+		for (uint32_t x = 0; x < n; x++) {
+			row[x] = 0;
+		}
+	}
+}
+
