  */
+/* Sense key of the last failed command (0xff: no sense data). */
+static uint8_t ufs_last_sense;
+
 static int
 ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 {
@@ -249,8 +252,13 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 
 	uint32_t ocs = utrd->dw2 & 0xff;
