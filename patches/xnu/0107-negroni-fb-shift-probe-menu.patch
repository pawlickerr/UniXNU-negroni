diff --git a/bsd/dev/negroni_keys.c b/bsd/dev/negroni_keys.c
index dadef49..627f244 100644
--- a/bsd/dev/negroni_keys.c
+++ b/bsd/dev/negroni_keys.c
@@ -76,6 +76,104 @@ keys_thread(void *arg, wait_result_t result)
 	}
 }
 
+static int keys_opened = -1;
+
+static int
+keys_open(void)
+{
+	if (keys_opened >= 0) {
+		return keys_opened;
+	}
+	keys_arb.core = (volatile uint32_t *)ml_io_map(KEYS_CORE_PA, KEYS_CORE_SIZE);
+	keys_arb.obs = (volatile uint32_t *)ml_io_map(KEYS_OBS_PA, KEYS_OBS_SIZE);
+	keys_arb.ee = 0;
+	if (!keys_arb.core || !keys_arb.obs) {
+		printf("NEGRONI KEYS: MMIO mapping failed\n");
+		return keys_opened = 1;
+	}
+	int rc = sk_open(&keys_arb, &keys_apid);
+	printf("NEGRONI KEYS: arb=%#x pon-apid=%d gpio6-apid=%d open=%d\n",
+	    keys_arb.core[0], keys_apid.pon, keys_apid.gpio, rc);
+	if (rc) {
+		printf("NEGRONI KEYS: arbiter or PON not found, keys off\n");
+	}
+	return keys_opened = rc ? 1 : 0;
+}
+
+/*
+ * Probe menu, before the key thread starts (one reader of the observer channel at a time):
+ * hold Volume Up during the prompt to open it. Volume Up raises the selected count,
+ * Volume Down selects the other one, Power runs. The counts replace negroniadreno /
+ * negroniwifi for this boot (negroni_adreno.c, negroni_wifi.c read negroni_probe_*).
+ */
+uint32_t negroni_probe_gpu = ~0u, negroni_probe_wifi = ~0u;
+void negroni_probe_menu(void);
+
+#define PROBE_GPU_MAX   14
+#define PROBE_WIFI_MAX  4
+
+static uint8_t
+keys_now(void)
+{
+	uint8_t pressed = 0;
+	return sk_sample(&keys_arb, &keys_apid, &pressed) ? 0 : pressed;
+}
+
+void
+negroni_probe_menu(void)
+{
+	uint32_t value[2] = { 0, 0 }, field = 0, menu = 1;
+	uint8_t was;
+
+	(void)PE_parse_boot_argn("negronimenu", &menu, sizeof(menu));
+	if (!menu || keys_open()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negroniadreno", &value[0], sizeof(value[0]));
+	(void)PE_parse_boot_argn("negroniwifi", &value[1], sizeof(value[1]));
+	printf("\nNEGRONI PROBE MENU: hold VOLUME UP now to open it (2 s)\n");
+	bool open = false;
+	for (int i = 0; i < 100 && !open; i++) {
+		open = (keys_now() & SK_KEY_VOLUP) != 0;
+		delay(20000);
+	}
+	if (!open) {
+		return;
+	}
+	printf("NEGRONI PROBE MENU: VOL+ = +1, VOL- = switch GPU/WIFI, POWER = run (60 s timeout)\n");
+	while (keys_now() & SK_KEY_VOLUP) {
+		delay(20000);
+	}
+	was = 0;
+	for (int ticks = 0; ticks < 3000; ticks++) {
+		uint8_t now = keys_now(), edge = now & ~was;
+		was = now;
+		if (ticks == 0 || edge) {
+			if (edge & SK_KEY_VOLUP) {
+				uint32_t max = field ? PROBE_WIFI_MAX : PROBE_GPU_MAX;
+				value[field] = value[field] >= max ? 0 : value[field] + 1;
+			}
+			if (edge & SK_KEY_VOLDOWN) {
+				field ^= 1;
+			}
+			if (edge & SK_KEY_POWER) {
+				break;
+			}
+			printf("NEGRONI PROBE MENU: %sGPU steps %u%s   %sWIFI steps %u%s\n",
+			    field ? " " : "[", value[0], field ? " " : "]",
+			    field ? "[" : " ", value[1], field ? "]" : " ");
+			ticks = 0;
+		}
+		delay(20000);
+	}
+	negroni_probe_gpu = value[0];
+	negroni_probe_wifi = value[1];
+	printf("NEGRONI PROBE MENU: running GPU steps 1..%u, WIFI steps 1..%u\n", value[0], value[1]);
+	while (keys_now() & SK_KEY_POWER) {
+		delay(20000);
+	}
+}
+
