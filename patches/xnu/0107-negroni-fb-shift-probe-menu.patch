-	keys_arb.obs = (volatile uint32_t *)ml_io_map(KEYS_OBS_PA, KEYS_OBS_SIZE);
-	keys_arb.ee = 0;
-	if (!keys_arb.core || !keys_arb.obs) {
-		printf("NEGRONI KEYS: MMIO mapping failed\n");
-		return;
-	}
-	int rc = sk_open(&keys_arb, &keys_apid);
-	printf("NEGRONI KEYS: arb=%#x pon-apid=%d gpio6-apid=%d open=%d\n",
-	    keys_arb.core[0], keys_apid.pon, keys_apid.gpio, rc);
-	if (rc) {
-		printf("NEGRONI KEYS: arbiter or PON not found, keys off\n");
+	if (keys_open()) {
 		return;
 	}
