 {
 	static const char *const rails[] = { "smpe2", "smpb11", "smpb10", "smpc1", "smpb12" };
 	unsigned found = 0;
 
-	announce("look the Wi-Fi rails up in cmd-db (read only)");
+	announce("look the Wi-Fi rails up in cmd-db at 0x80860000 (read only)");
+	cmd_db = ml_io_map(CMD_DB_PHYS, CMD_DB_SIZE);
+	if (!cmd_db || db32(4) != 0x0c0330db) {
+		printf("NEGRONI WIFI: 3 stop: no cmd-db at %#lx (magic %#x)\n", CMD_DB_PHYS, cmd_db ? db32(4) : 0);
+		return false;
+	}
 	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
 		uint32_t address = 0;
-		int error = negroni_rpmh_lookup(rails[i], &address);
+		int error = cmd_db_lookup(rails[i], &address);
 		printf("NEGRONI WIFI: 3 %s -> %s %#x\n", rails[i], error ? "error" : "address", error ? (uint32_t)error : address);
 		found += !error;
 	}
