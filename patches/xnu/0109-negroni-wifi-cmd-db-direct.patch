+/* cmd-db (Linux drivers/soc/qcom/cmd-db.c): header, 8 slave headers, then entries of 24 bytes. */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000u
+#define CMD_DB_HEADER           (4 + 4 + 8 * 16 + 4 + 4)        /* version, magic, slaves, checksum, reserved */
+
+static vm_offset_t cmd_db;
+
+static uint32_t
+db32(uint32_t off)
+{
+	return off + 4 <= CMD_DB_SIZE ? rd(cmd_db + off) : 0;
+}
+
+static uint16_t
+db16(uint32_t off)
+{
+	return (uint16_t)(db32(off & ~3u) >> (8 * (off & 2)));
+}
+
+static int
+cmd_db_lookup(const char *name, uint32_t *address)
+{
+	uint32_t key[2] = { 0, 0 };
+
+	for (unsigned i = 0; i < 8 && name[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+	}
+	for (unsigned s = 0; s < 8; s++) {
+		uint32_t h = 8 + 16 * s;
+		uint32_t entries = CMD_DB_HEADER + db16(h + 2), count = db16(h + 6);
+		if (db16(h) == 0 || count > 1024 || entries + count * 24 > CMD_DB_SIZE) {
+			continue;
+		}
+		for (uint32_t j = 0; j < count; j++) {
+			uint32_t e = entries + 24 * j;
+			if (db32(e) == key[0] && db32(e + 4) == key[1]) {
+				*address = db32(e + 16);
+				return 0;
+			}
+		}
+	}
+	return ENOENT;
+}
+
 static bool
