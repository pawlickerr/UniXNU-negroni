From: negroni-ios
Subject: [PATCH] negroni: SM8450 keys (SPMI arbiter v7 observer, PMK8350 PON + PM8350 GPIO6)

---
diff --git a/bsd/dev/negroni_keys.c b/bsd/dev/negroni_keys.c
index 42dd728..3e988eb 100644
--- a/bsd/dev/negroni_keys.c
+++ b/bsd/dev/negroni_keys.c
@@ -1,8 +1,11 @@
 /*
- * Minimal polled NEGRONI keys. Call once after the scheduler is running.
- * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
- * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
- * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ * Polled NEGRONI keys (OnePlus 10 Pro 5G, SM8450). Call once after the scheduler is running.
+ * SPMI PMIC arbiter v7, read through the observer channel of EE 0 (negroni_spmi_keys.h, shared with
+ * the Mu-Silicium NegroniKeyInputDxe):
+ *   power       PMK8350 (SID 0) PON PID 0x13, RT_STS bit 7 (KPDPWR)
+ *   volume up   same register, bit 6 (RESIN)
+ *   volume down PM8350 (SID 1) GPIO6, RT_STS bit 0, active low
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an observer channel.
  */
 #if defined(ARM64_BOARD_CONFIG_NEGRONI)
 #include <sys/param.h>
@@ -12,75 +15,22 @@
