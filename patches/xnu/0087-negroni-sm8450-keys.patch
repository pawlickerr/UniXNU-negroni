+#define KEYS_CORE_PA     0x0c400000u     /* arbiter core (APID map at +0x2000) */
+#define KEYS_CORE_SIZE   0x3000u
+#define KEYS_OBS_PA      0x0c440000u     /* observer channels, EE 0 first */
