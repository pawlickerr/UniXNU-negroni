+static bool
+step_cx_power(void)
+{
+	uint32_t gdscr = rd(gpucc + GPUCC_CX_GDSCR);
+
+	if (cx_is_on()) {
+		printf("NEGRONI ADRENO: 4 CX is on already (%#x)\n", gdscr);
+		return true;
+	}
+	if (gdscr & GDSC_HW_CONTROL) {
+		printf("NEGRONI ADRENO: 4 stop: CX GDSC is under hardware control (%#x)\n", gdscr);
+		return false;
+	}
+	announce("switch the CX GDSC on (clear SW_COLLAPSE)");
+	put(gpucc, "GPU_CX_GDSCR", GPUCC_CX_GDSCR, gdscr & ~GDSC_SW_COLLAPSE);
+	if (!wait_for(gpucc + GPUCC_CX_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, 50)) {
+		printf("NEGRONI ADRENO: 4 stop: CX does not come on (%#x)\n", rd(gpucc + GPUCC_CX_GDSCR));
+		return false;
