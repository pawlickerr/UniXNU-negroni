+static void
+put(vm_offset_t base, const char *name, uint32_t offset, uint32_t value)
+{
+	uint32_t was = rd(base + offset);
+
+	wr(base + offset, value);
+	printf("NEGRONI ADRENO: %u %s %#x -> %#x (reads %#x)\n", step, name, was, value, rd(base + offset));
+}
+
+/* Wait up to `ms` for (reg & mask) == want. */
+static bool
+wait_for(vm_offset_t address, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms * 10; i++) {
+		if ((rd(address) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return (rd(address) & mask) == want;
+}
+
+static bool
+clock_on(vm_offset_t base, const char *name, uint32_t cbcr, bool must)
+{
+	put(base, name, cbcr, rd(base + cbcr) | CBCR_ENABLE);
+	if (wait_for(base + cbcr, CBCR_OFF, 0, 10)) {
+		return true;
+	}
+	/* Some branches' status bits are not reliable (halt_check in Linux): `must` says which count. */
+	printf("NEGRONI ADRENO: %u %s stays off (%#x)%s\n", step, name, rd(base + cbcr),
+	    must ? "" : ", not a reliable status bit, going on");
+	return !must;
+}
+
+static bool
+clock_source(const char *name, uint32_t rcgr, uint32_t source)
+{
+	uint32_t cfg = rd(gpucc + rcgr + 4);
+
+	if ((cfg & RCG_SOURCE_MASK) == source) {
+		printf("NEGRONI ADRENO: %u %s already at %#x\n", step, name, cfg);
+		return true;
+	}
+	put(gpucc, name, rcgr + 4, (cfg & ~RCG_SOURCE_MASK) | source);
+	put(gpucc, name, rcgr, rd(gpucc + rcgr) | RCG_UPDATE);
+	if (!wait_for(gpucc + rcgr, RCG_UPDATE, 0, 10)) {
+		printf("NEGRONI ADRENO: %u %s does not take its new source (cmd %#x)\n", step, name, rd(gpucc + rcgr));
+		return false;
+	}
+	return true;
+}
+
+static bool
+cfg_ahb_running(void)
+{
+	return !(rd(gcc + GCC_GPU_CFG_AHB_CBCR) & CBCR_OFF);
+}
+
+static bool
+cx_is_on(void)
+{
+	return (rd(gpucc + GPUCC_CX_GDSCR) & GDSC_PWR_ON) != 0;
+}
+
+/* ---- the steps ---- */
+
+static bool
+step_gcc(void)
+{
+	static const struct { const char *name; uint32_t offset; } r[] = {
+		{ "GCC_GPU_CFG_AHB_CLK", GCC_GPU_CFG_AHB_CBCR },
+		{ "GCC_GPU_MEMNOC_GFX_CLK", GCC_GPU_MEMNOC_GFX_CBCR },
+		{ "GCC_GPU_SNOC_DVM_GFX_CLK", GCC_GPU_SNOC_DVM_CBCR },
+		{ "GCC_DDRSS_GPU_AXI_CLK", GCC_DDRSS_GPU_AXI_CBCR },
+		{ "GCC_PLL_VOTE", GCC_PLL_VOTE },
+	};
+
+	announce("read GCC GPU branches");
+	for (unsigned i = 0; i < sizeof(r) / sizeof(r[0]); i++) {
+		uint32_t v = rd(gcc + r[i].offset);
+		printf("NEGRONI ADRENO: 1 %s = %#x%s\n", r[i].name, v,
+		    r[i].offset == GCC_PLL_VOTE ? "" : (v & CBCR_OFF) ? " (off)" : " (running)");
+	}
+	if (!cfg_ahb_running()) {
+		printf("NEGRONI ADRENO: 1 stop: GCC_GPU_CFG_AHB_CLK is off, GPUCC unreachable\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_gpucc_read(void)
+{
+	static const struct { const char *name; uint32_t offset; bool gdsc; } r[] = {
+		{ "GPU_CX_GDSC", GPUCC_CX_GDSCR, true },
+		{ "GPU_GX_GDSC", GPUCC_GX_GDSCR, true },
+		{ "GPU_CC_AHB_CLK", GPUCC_AHB_CBCR, false },
+		{ "GPU_CC_CX_GMU_CLK", GPUCC_CX_GMU_CBCR, false },
+		{ "GPU_CC_CXO_CLK", GPUCC_CXO_CBCR, false },
+		{ "GPU_CC_HUB_CX_INT_CLK", GPUCC_HUB_CX_INT_CBCR, false },
+		{ "GPU_CC_HUB_AON_CLK", GPUCC_HUB_AON_CBCR, false },
+		{ "GPU_CC_MEMNOC_GFX_CLK", GPUCC_MEMNOC_GFX_CBCR, false },
+		{ "GPU_CC_CX_SNOC_DVM_CLK", GPUCC_CX_SNOC_DVM_CBCR, false },
+		{ "GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK", GPUCC_SMMU_VOTE_CBCR, false },
+	};
+
+	announce("read GPUCC (GDSCs and CX clocks)");
+	for (unsigned i = 0; i < sizeof(r) / sizeof(r[0]); i++) {
+		uint32_t v = rd(gpucc + r[i].offset);
+		printf("NEGRONI ADRENO: 2 %s = %#x (%s)\n", r[i].name, v,
+		    r[i].gdsc ? ((v & GDSC_PWR_ON) ? "powered" : "off") : ((v & CBCR_OFF) ? "off" : "running"));
+	}
+	printf("NEGRONI ADRENO: 2 GMU RCG cmd %#x cfg %#x, hub RCG cmd %#x cfg %#x\n",
+	    rd(gpucc + GPUCC_GMU_RCGR), rd(gpucc + GPUCC_GMU_RCGR + 4),
+	    rd(gpucc + GPUCC_HUB_RCGR), rd(gpucc + GPUCC_HUB_RCGR + 4));
+	return true;
+}
+
+static void
+gmu_words(void)
+{
+	uint32_t first = rd(gmu + GMU_REG(GMU_AO_COUNTER_L)), last = first;
+
+	for (int i = 0; i < 3; i++) {
+		delay(1000);
+		last = rd(gmu + GMU_REG(GMU_AO_COUNTER_L));
+		printf("NEGRONI ADRENO: %u GMU AO counter low = %#x\n", step, last);
+	}
+	printf("NEGRONI ADRENO: %u GMU AO counter %s; CM3_FW_INIT_RESULT = %#x, CM3_SYSRESET = %#x\n", step,
+	    last != first ? "COUNTS" : "does not count",
+	    rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)), rd(gmu + GMU_REG(GMU_CM3_SYSRESET)));
+}
+
+static bool
+step_gmu_read_if_on(void)
+{
