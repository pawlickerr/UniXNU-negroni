+#define GCC_GPU_SNOC_DVM_CBCR   0x81018
+#define GCC_DDRSS_GPU_AXI_CBCR  0x81154
+#define GCC_PLL_VOTE            0x62000         /* gcc_gpu_gpll0_clk_src BIT(15), _div_ BIT(16) */
+#define GCC_PLL_VOTE_GPU        ((1u << 15) | (1u << 16))
